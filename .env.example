# ==============================================================================
# GOTHAM COMMAND — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
# Production: Point to your secure PostgreSQL 16 cluster with SSL enabled
DATABASE_URL=jdbc:postgresql://localhost:5432/gotham
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# Production: Set GOOGLE_REDIRECT_URI to your public HTTPS backend origin:
# https://api.yourdomain.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# JWT Access Token Configuration
# Production: Must be a cryptographically secure random key (at least 256 bits / 32 bytes)
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-256-bits-length
# Expiration in milliseconds (default: 900000 = 15 minutes)
JWT_EXPIRATION=900000

# CORS & Frontend Origins
# Production: Set to your exact production frontend URL(s) comma-separated, NEVER "*"
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Refresh Token & Cookie Configuration
# Refresh token lifetime in ms (default: 604800000 = 7 days)
REFRESH_TOKEN_EXPIRATION=604800000
# Production: MUST be set to true when running over HTTPS
# Development: false allows cookies over plain HTTP localhost
REFRESH_COOKIE_SECURE=false

# Client-side Vite Configuration (Embedded at build time)
# In production, these should match your production domain:
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_BACKEND_URL=https://api.yourdomain.com
VITE_API_URL=http://localhost:8080/api
VITE_BACKEND_URL=http://localhost:8080
